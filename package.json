{
  "name": "kkufa-visa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "KKU Faculty of International Affairs - student visa extension request system",
  "scripts": {
    "dev": "vite dev",
    "build": "svelte-kit sync && vite build",
    "preview": "vite preview",
    "start": "node build/index.js",
    "check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
    "test": "node --test tests/",
    "db:migrate": "node src/lib/server/db/migrate.js"
  },
  "dependencies": {
    "@sveltejs/adapter-node": "^5.2.12",
    "@sveltejs/kit": "2.8.0",
    "mysql2": "^3.12.0",
    "pdf-lib": "^1.17.1",
    "sharp": "^0.33.5",
    "tesseract.js": "^5.1.1"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^3.1.2",
    "svelte": "^4.2.19",
    "svelte-check": "^4.1.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.11"
  }
}
